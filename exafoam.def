Bootstrap: docker
From: ubuntu:24.04

%environment
	NVARCH=`uname -s`_`uname -m`; export NVARCH
	NVCOMPILERS=/opt/nvidia/hpc_sdk; export NVCOMPILERS
	MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/24.3/compilers/man; export MANPATH
	PATH=$NVCOMPILERS/$NVARCH/24.3/compilers/bin:$PATH; export PATH
	
	export PATH=$NVCOMPILERS/$NVARCH/24.3/comm_libs/mpi/bin:$PATH
	export MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/24.3/comm_libs/mpi/man
	
	export LD_LIBRARY_PATH=$NVCOMPILERS/$NVARCH/24.3/cuda/lib:$NVCOMPILERS/$NVARCH/24.3/compilers/lib:$LD_LIBRARY_PATH
	
	export have_cuda=true
	export NVARCH=75
	
	. /opt/openfoam/OpenFOAM-com/etc/bashrc -f

%files

%post
    cd /opt

    export DEBIAN_FRONTEND=noninteractive

    apt update
    apt install -y build-essential autoconf autotools-dev cmake curl software-properties-common git vim wget hwloc flex libfl-dev libreadline-dev zlib1g-dev
    
    # apt install -y libgmp-dev libmpfr-dev libmpc-dev libscotch-dev libptscotch-dev libmetis-dev  libpmi2-0 libpmi2-0-dev openmpi-bin openmpi-common libopenmpi-dev libhdf5-dev libhdf5-openmpi-dev
 
     
     apt install -y nvidia-driver-550
     
     
      curl https://developer.download.nvidia.com/hpc-sdk/ubuntu/DEB-GPG-KEY-NVIDIA-HPC-SDK | gpg --y --dearmor -o /usr/share/keyrings/nvidia-hpcsdk-archive-keyring.gpg 
      echo 'deb [signed-by=/usr/share/keyrings/nvidia-hpcsdk-archive-keyring.gpg] https://developer.download.nvidia.com/hpc-sdk/ubuntu/amd64 /' | tee /etc/apt/sources.list.d/nvhpc.list 
      apt-get update -y 
      apt-get install -y nvhpc-23-11-cuda-multi 
     
    NVARCH=`uname -s`_`uname -m`; export NVARCH
	NVCOMPILERS=/opt/nvidia/hpc_sdk; export NVCOMPILERS
	MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/23.11/compilers/man; export MANPATH
	PATH=$NVCOMPILERS/$NVARCH/23.11/compilers/bin:$PATH; export PATH
	
	export PATH=$NVCOMPILERS/$NVARCH/23.11/comm_libs/mpi/bin:$PATH
	export MANPATH=$MANPATH:$NVCOMPILERS/$NVARCH/23.11/comm_libs/mpi/man
	
	export LD_LIBRARY_PATH=$NVCOMPILERS/$NVARCH/23.11/cuda/lib:$NVCOMPILERS/$NVARCH/23.11/compilers/lib:$LD_LIBRARY_PATH
     
    mkdir openfoam && cd openfoam
    git clone https://gitlab.hpc.cineca.it/exafoam/spuma.git OpenFOAM-com
    cd OpenFOAM-com
    
    git clone https://develop.openfoam.com/Development/ThirdParty-common.git ThirdParty
    cd ThirdParty
    
    wget https://gforge.inria.fr/frs/download.php/file/38352/scotch_6.1.0.tar.gz
	tar -zxf scotch_6.1.0.tar.gz && rm scotch_6.1.0.tar.gz
	
	wget https://github.com/KaHIP/KaHIP/archive/v3.15.tar.gz
	tar -zxf v3.15.tar.gz && mv KaHIP-3.15 kahip-3.15 && rm v3.15.tar.gz
	
	wget https://archives.boost.io/release/1.74.0/source/boost_1_74_0.tar.bz2 
	tar -jxf boost_1_74_0.tar.bz2 && rm boost_1_74_0.tar.bz2
	
	wget https://www.fftw.org/fftw-3.3.10.tar.gz
	tar -zxf fftw-3.3.10.tar.gz && rm fftw-3.3.10.tar.gz
	
	wget https://github.com/CGAL/cgal/releases/download/releases%2FCGAL-4.14.3/CGAL-4.14.3.tar.xz
	tar -xf CGAL-4.14.3.tar.xz && rm CGAL-4.14.3.tar.xz
	
	cd ..
	
    sed -i \
  	-e 's|^projectDir="$HOME/OpenFOAM/OpenFOAM-$WM_PROJECT_VERSION"|# projectDir="$HOME/OpenFOAM/OpenFOAM-$WM_PROJECT_VERSION"|' \
  	-e 's|^# projectDir="/opt/openfoam/OpenFOAM-$WM_PROJECT_VERSION"|projectDir="/opt/openfoam/OpenFOAM-$WM_PROJECT_VERSION"|' \
  	etc/bashrc

	export have_cuda=true
	export NVARCH=75

	. etc/bashrc -f
	
	./Allwmake -j
	
    apt clean
    rm -rf /var/lib/apt/lists/*
  	

